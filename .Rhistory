library(tidyverse)
a1 <- runif(n = 100, min = 0, max = 12)
df1 <- tibble(a1)  # 結果をデータフレーム (tibble) に入れる
h1 <- ggplot(df1, aes(x = a1, y = after_stat(density))) +
geom_histogram(binwidth = 0.5,
