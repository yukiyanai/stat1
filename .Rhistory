library(tidyverse)
#| message: false
theme_set(theme_gray(base_size = 9,
base_family = "HiraginoSans-W3"))
dir("data")
#| message: false
D <- read_csv("data/fake_height_round.csv")
glimpse(D)
table(D$gender)
#| hold: true
D_f <- D |>
filter(gender == "female")
#D_f <- filter(D, gender == "female") # パイプを使わない方法
table(D_f$gender)
hist_1 <- ggplot(D_f, aes(x = height)) +
geom_histogram(binwidth = 2,
boundary = 140,
color = "black")
plot(hist_1)
hist_2 <- ggplot(D_f, aes(x = height,
y = after_stat(density))) +
geom_histogram(binwidth = 2,
boundary = 140,
color = "black")
plot(hist_2)
hist_2a <- hist_2 +
labs(x = "身長 (cm)", y = "密度")
plot(hist_2a)
ecdf_1 <- ggplot(D_f, aes(x = height)) +
geom_hline(yintercept = c(0, 1),
color = "gray") +
stat_ecdf() +
labs(x = "身長 (cm)", y = "割合")
plot(ecdf_1)
D_f$height |>
head(n = 10)
hist_2b <- hist_2a +
geom_density(color = "royalblue",
linewidth = 1.5)
plot(hist_2b)
N <- 10
x <- seq(from = 130, to = 190, length.out = N)
x
dens <- dnorm(x, mean = 158.2, sd = 5.7)
dens
D1 <- tibble(x = x,
density = dens)
p_dens_1 <- ggplot(D1, aes(x = x, y = density)) +
geom_line() +
geom_point()
plot(p_dens_1)
N <- 1e5 # 1e5 = 10^5 = 100000
x <- seq(from = 130, to = 190, length.out = N)
D2 <- tibble(x = x,
density = dnorm(x,  mean = 158.2, sd = 5.7))
p_dens_2 <- ggplot(D2, aes(x = x, y = density)) +
geom_line(color = "tomato")
plot(p_dens_2)
hist_2c <- hist_2a +
geom_line(data = D2, aes(x = x, y = density),
color = "tomato",
linewidth = 1.2)
plot(hist_2c)
